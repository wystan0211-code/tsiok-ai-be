rules_version = '2';

// 九愛！買 Firestore 安全規則
// 部署前必改：把下方 adminUid() 的內容換成管理員帳號的 UID
// 發布方式：Firebase 主控台 > Firestore Database > 規則 > 貼上全部內容 > 發布

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 身分 =====
    function adminUid() { return 'faA2Ez0SF4Ue84HdflQXy8qQhxK2'; }

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.uid == adminUid(); }

    function path(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    function userPath() { return path('users', request.auth.uid); }

    // 員工資料存在 users/{uid}，停用的帳號沒有任何權限
    // 只讀取一次 users 文件(規則讀取次數有上限)
    function roleOk(u, roles) { return u.disabled == false && u.role in roles; }
    function hasRole(roles) {
      return signedIn() && exists(userPath()) && roleOk(get(userPath()).data, roles);
    }
    function isStaff() { return isAdmin() || hasRole(['staff', 'manager']); }
    function isManager() { return isAdmin() || hasRole(['manager']); }
    // 預購主管：只看預購單(C)、標示付款；管理員也有這個權限
    function isPresaleMgr() { return isAdmin() || hasRole(['presale']); }

    // ===== 共用 =====
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 預購單超過付款期限仍未付款：作廢(付款期限 = 退回時間或建立時間 + payHours 小時)
    function presaleVoid(o) {
      return o.get('type', '') == 'presale' && o.status == 'pending'
        && request.time > o.get('payFrom', o.get('createdAt', request.time)) + duration.value(o.get('payHours', 12), 'h');
    }
    // 訂單已結束：已取餐、已拒絕、已取消、已刪除，或建立超過 12 小時(與 js/core/order-logic.js 的 ORDER_TTL_MS 相同)
    // 預購單不套用 12 小時，改用付款期限(活動當天才取餐)
    function finalStatus(o) {
      return o.status in ['picked', 'rejected', 'cancelled'] || o.get('deleted', false) == true
        || (o.get('type', '') != 'presale' && request.time > o.get('createdAt', request.time) + duration.value(12, 'h'))
        || presaleVoid(o);
    }
    // 訂單已結束，或已不存在(例如在主控台被刪除)：綁定的電話與點餐連結可以重新使用
    function orderDone(orderId) {
      return !exists(path('orders', orderId)) || finalStatus(get(path('orders', orderId)).data);
    }
    // 編號格式：A001、B012、A123
    function fmtNo(prefix, seq) {
      return seq < 10 ? prefix + '00' + string(seq)
        : (seq < 100 ? prefix + '0' + string(seq) : prefix + string(seq));
    }

    // 顧客送出的明細：最多 10 行，每行只能有 itemId、qty、option、sel，數量為 1～50 的整數
    // 正式環境對每次送出的規則運算量有上限，明細多時會被擋下，所以每行只做最必要的檢查
    // (品項、選項文字等不在這裡檢查；實際金額與庫存由攤位接單時依菜單重新計算)
    function lineOk(items, i) {
      return items.size() <= i || (
        items[i].keys().hasOnly(['itemId', 'qty', 'option', 'sel'])
        && items[i].qty is int && items[i].qty >= 1 && items[i].qty <= 50
      );
    }
    function linesOk(items) {
      return items is list && items.size() >= 1 && items.size() <= 10
        && lineOk(items, 0) && lineOk(items, 1) && lineOk(items, 2) && lineOk(items, 3)
        && lineOk(items, 4) && lineOk(items, 5) && lineOk(items, 6) && lineOk(items, 7)
        && lineOk(items, 8) && lineOk(items, 9);
    }
    function qtyAt(items, i) { return items.size() > i ? items[i].qty : 0; }
    function sumQty(items) {
      return qtyAt(items, 0) + qtyAt(items, 1) + qtyAt(items, 2) + qtyAt(items, 3) + qtyAt(items, 4)
        + qtyAt(items, 5) + qtyAt(items, 6) + qtyAt(items, 7) + qtyAt(items, 8) + qtyAt(items, 9);
    }

    // ===== 營業設定：所有人可讀；攤位主管可改(含平台模式)；預購主管只能改預購付款期限 =====
    match /settings/{docId} {
      allow read: if true;
      allow create: if isManager();
      allow update: if isManager()
        || (isPresaleMgr() && onlyChanged(['presalePayHours', 'updatedAt'])
            && request.resource.data.presalePayHours is int
            && request.resource.data.presalePayHours >= 1 && request.resource.data.presalePayHours <= 48);
      allow delete: if isAdmin();
    }

    // ===== 品項：所有人可讀；攤位主管可改；店員接單時只能更新售出數量 =====
    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager()
        || (isStaff() && onlyChanged(['soldCount', 'soldOut', 'updatedAt']));
    }

    // 品項照片：{照片ID}_s 小圖、{照片ID}_l 大圖(舊資料為 {品項ID})
    match /itemImages/{imageId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ===== 菜單分類、橫幅輪播、網站圖片(攤位位置圖)：所有人可讀，攤位主管可改 =====
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ===== 員工帳號資料：只有管理員能寫(實際由 Apps Script 以服務帳戶寫入) =====
    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== 訂單編號計數器 =====
    function prevCounter() { return resource == null ? 0 : resource.data.value; }
    function counterOk(type) {
      let d = request.resource.data;
      let o = getAfter(path('orders', d.lastOrderId)).data;
      return d.keys().hasOnly(['value', 'lastOrderId'])
        && d.value == prevCounter() + 1
        && o.seq == d.value
        && ((type == 'A' && o.type == 'preorder' && o.uid == uid())
            || (type == 'B' && o.type == 'walkin' && isStaff())
            || (type == 'C' && o.type == 'presale' && o.uid == uid()));
    }
    match /counters/{type} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow create, update: if isAdmin() || (signedIn() && counterOk(type));
      allow delete: if isAdmin();
    }

    // ===== 一次性點餐連結 =====
    function freshSession() {
      let d = request.resource.data;
      return d.keys().hasOnly(['token', 'used', 'orderId', 'updatedAt'])
        && d.used == false && d.orderId == null
        && d.token is string && d.token.size() >= 16 && d.token.size() <= 64;
    }
    match /sessions/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId && freshSession();
      allow update: if signedIn() && uid() == userId && (
        // 重新掃描 QR code：上一張訂單結束後才能產生新連結
        (freshSession() && (resource.data.used == false || orderDone(resource.data.orderId)))
        // 送出訂單時把連結標記為已使用
        || (resource.data.used == false && request.resource.data.used == true
          && request.resource.data.keys().hasOnly(['token', 'used', 'orderId', 'updatedAt'])
          && request.resource.data.token == resource.data.token
          && getAfter(path('orders', request.resource.data.orderId)).data.uid == userId)
      );
    }

    // ===== 訂單 =====
    function preorderChecks(orderId) {
      let d = request.resource.data;
      let s = get(path('sessions', uid())).data;
      let sAfter = getAfter(path('sessions', uid())).data;
      let c = getAfter(path('counters', 'A')).data;
      let settings = get(path('settings', 'app')).data;
      return d.keys().hasOnly(['type', 'seq', 'no', 'status', 'uid', 'items', 'itemCount', 'surname',
                               'title', 'lang', 'pushEnabled', 'subPref', 'createdAt', 'updatedAt'])
        && d.uid == uid() && d.status == 'pending' && d.pushEnabled == false
        && d.get('subPref', 'remove') in ['choose', 'similar', 'remove']
        && d.get('lang', 'zh-Hant') in ['zh-Hant', 'en', 'ja']
        && d.surname is string && d.surname.size() >= 1 && d.surname.size() <= 10
        && d.title in ['先生', '小姐', '其他']
        && linesOk(d.items) && d.itemCount == sumQty(d.items) && d.itemCount >= 1
        && settings.acceptingPreorders == true
        && d.itemCount <= settings.maxItemsPerOrder
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.seq is int && c.value == d.seq && c.lastOrderId == orderId
        && d.no == fmtNo('A', d.seq)
        && s.used == false && sAfter.used == true && sAfter.orderId == orderId
        && existsAfter(path('contacts', orderId));
    }
    // 預購單(C)：預購模式開啟時才能送出；全名至少 2 字、稱謂老師／主任／其他、取餐時段、付款期限
    // 時段名額在標示付款時才占用，這裡不檢查
    function presaleChecks(orderId) {
      let d = request.resource.data;
      let s = get(path('sessions', uid())).data;
      let sAfter = getAfter(path('sessions', uid())).data;
      let c = getAfter(path('counters', 'C')).data;
      let settings = get(path('settings', 'app')).data;
      let maxItems = settings.get('presaleMaxItems', null);
      let payHours = settings.get('presalePayHours', null);
      return d.keys().hasOnly(['type', 'seq', 'no', 'status', 'uid', 'items', 'itemCount', 'surname', 'title',
                               'lang', 'pushEnabled', 'slotId', 'payHours', 'paid', 'createdAt', 'updatedAt'])
        && d.uid == uid() && d.status == 'pending' && d.pushEnabled == false && d.paid == false
        && d.get('lang', 'zh-Hant') in ['zh-Hant', 'en', 'ja']
        && d.surname is string && d.surname.size() >= 2 && d.surname.size() <= 10
        && d.title in ['老師', '主任', '其他']
        && d.slotId is string && d.slotId.size() >= 1 && d.slotId.size() <= 40
        && d.payHours == (payHours == null ? 12 : payHours)
        && linesOk(d.items) && d.itemCount == sumQty(d.items) && d.itemCount >= 1
        && settings.get('orderMode', '') == 'presale'
        && (maxItems == null || maxItems == 0 || d.itemCount <= maxItems)
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.seq is int && c.value == d.seq && c.lastOrderId == orderId
        && d.no == fmtNo('C', d.seq)
        && s.used == false && sAfter.used == true && sAfter.orderId == orderId
        && existsAfter(path('contacts', orderId));
    }
    function walkinChecks(orderId) {
      let d = request.resource.data;
      let c = getAfter(path('counters', 'B')).data;
      return d.seq is int && c.value == d.seq && c.lastOrderId == orderId
        && d.no == fmtNo('B', d.seq)
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function staffUpdateOk() {
      let d = request.resource.data;
      let o = resource.data;
      return isStaff()
        && d.type == o.type && d.seq == o.seq && d.no == o.no
        && d.get('uid', null) == o.get('uid', null)
        && d.get('deleted', false) == o.get('deleted', false)
        && d.status in ['pending', 'accepted', 'ready', 'picked', 'rejected', 'cancelled']
        && d.updatedAt == request.time
        // 預購單：付款狀態只能由預購主管改；未付款時店員不能操作
        && d.get('paid', false) == o.get('paid', false)
        && (o.get('type', '') != 'presale' || o.get('paid', false) == true);
    }
    // 預購主管：標示已付款(請付款 → 已接單)或退回未付款(已接單 → 請付款，重新計算付款期限)
    function presaleMgrUpdateOk() {
      let d = request.resource.data;
      let o = resource.data;
      return o.get('type', '') == 'presale'
        && d.type == o.type && d.seq == o.seq && d.no == o.no && d.uid == o.uid
        && d.updatedAt == request.time
        && onlyChanged(['status', 'paid', 'paidAt', 'payFrom', 'payHours', 'slotId', 'slotChanged',
                        'lines', 'total', 'acceptedAt', 'establishedAt', 'updatedAt'])
        && ((o.status == 'pending' && d.status == 'accepted' && d.paid == true)
          || (o.status == 'accepted' && d.status == 'pending' && d.paid == false
              && d.payFrom == request.time && d.payHours is int && d.payHours >= 1 && d.payHours <= 48))
        && isPresaleMgr();
    }
    function customerUpdateOk() {
      let d = request.resource.data;
      let o = resource.data;
      return signedIn() && d.updatedAt == request.time && (
        // 本人在攤位接單前、送出 3 分鐘內取消
        (o.get('uid', null) == uid() && o.status == 'pending' && d.status == 'cancelled'
          && request.time < o.createdAt + duration.value(3, 'm')
          && d.cancelledAt == request.time && onlyChanged(['status', 'cancelledAt', 'updatedAt']))
        // 開啟推播(持有訂單連結者即可，iPhone 主畫面 App 與 Safari 身分不同)
        || (onlyChanged(['pushEnabled', 'updatedAt']) && d.pushEnabled == true)
        // 掃描現場取餐 QR code 認領訂單
        || (o.type == 'walkin' && o.get('claimedBy', null) == null && d.claimedBy == uid()
          && onlyChanged(['claimedBy', 'updatedAt']))
        // 本人回覆攤位的替代品詢問(只能寫入回覆，且必須對應目前這一次詢問)
        || (o.get('uid', null) == uid() && o.status in ['accepted', 'ready'] && ('shortage' in o)
          && onlyChanged(['shortageReply', 'updatedAt'])
          && d.shortageReply.id == o.shortage.id && d.shortageReply.answers is map)
      );
    }
    match /orders/{orderId} {
      // 訂單 ID 是隨機長字串，持有連結者才能讀取單筆；查詢清單只限員工
      allow get: if signedIn();
      // 預購主管查詢時必須加上 type == 'presale' 條件
      allow list: if isStaff() || (isPresaleMgr() && resource.data.type == 'presale');
      allow create: if signedIn() && (
        (request.resource.data.type == 'preorder' && preorderChecks(orderId))
        || (request.resource.data.type == 'walkin' && isStaff() && walkinChecks(orderId))
        || (request.resource.data.type == 'presale' && presaleChecks(orderId))
        || (request.resource.data.type == 'manual' && isAdmin())
      );
      allow update: if isAdmin() || presaleMgrUpdateOk() || staffUpdateOk() || customerUpdateOk();
      allow delete: if isAdmin();
    }

    // ===== 聯絡資料(電話)：只有員工與下單本人能讀 =====
    function contactPreorderOk(orderId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderId', 'surname', 'phone', 'consentNotify', 'consentText', 'consentAt', 'createdAt'])
        && d.orderId == orderId
        && d.phone is string && d.phone.matches('^09[0-9]{8}$')
        && d.surname is string && d.surname.size() >= 1 && d.surname.size() <= 10
        && d.consentNotify == true && d.consentText is string && d.consentText.size() <= 500
        && d.consentAt == request.time && d.createdAt == request.time
        && getAfter(path('orders', orderId)).data.uid == uid()
        && getAfter(path('activePhones', d.phone)).data.orderId == orderId;
    }
    match /contacts/{orderId} {
      allow get: if isStaff() || isPresaleMgr() || (signedIn() && get(path('orders', orderId)).data.get('uid', null) == uid());
      allow list: if isStaff();
      allow create: if signedIn() && (
        contactPreorderOk(orderId)
        || (isStaff() && getAfter(path('orders', orderId)).data.type == 'walkin')
      );
      allow update, delete: if isAdmin();
    }

    // ===== 每支電話同時只能有一張進行中的預點 =====
    function phoneLockOk(phone) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['uid', 'orderId', 'updatedAt'])
        && d.uid == uid() && d.updatedAt == request.time
        && getAfter(path('orders', d.orderId)).data.uid == uid()
        && getAfter(path('contacts', d.orderId)).data.phone == phone;
    }
    match /activePhones/{phone} {
      allow read: if isStaff();
      allow create: if phoneLockOk(phone);
      // 上一張訂單已結束或已不存在，才能被新訂單覆蓋
      allow update: if phoneLockOk(phone) && orderDone(resource.data.orderId);
      // 訂單結束(取餐、拒絕、取消、作廢)時，攤位可以解除綁定
      allow delete: if isAdmin() || (isStaff() && orderDone(resource.data.orderId));
    }

    // ===== 預購統計(單一文件 presaleStats/main)：slots 各時段已付款數、sold 各品項已付款的預購數量 =====
    // 所有人可讀(顧客端隱藏額滿時段與顯示剩餘數量)；預購主管標示付款時更新，管理員重設
    match /presaleStats/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['slots', 'sold', 'updatedAt'])
        && request.resource.data.slots is map && request.resource.data.sold is map
        && isPresaleMgr();
      allow delete: if isAdmin();
    }

    // ===== 顧客顯示頁：文件 ID 為 6 位數配對碼 =====
    // 現場點餐裝置(攤位人員)建立與更新；顧客顯示頁不用登入，只能讀取單一文件與回報「我還在」(seenAt)
    function screenOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'state', 'lines', 'total', 'count', 'lang', 'done', 'updatedAt', 'seenAt', 'view', 'overlay'])
        && d.state in ['idle', 'cart', 'done'] && d.lines is list && d.lines.size() <= 60
        && d.lang in ['zh-Hant', 'en', 'ja']
        && d.get('view', 'carousel') in ['carousel', 'board']
        && (d.get('overlay', null) == null || d.overlay is map);
    }
    match /screens/{pin} {
      allow get: if pin.matches('^[0-9]{6}$');
      allow list: if false;
      allow create: if pin.matches('^[0-9]{6}$') && isStaff() && screenOk();
      // 不用登入的顧客顯示頁只能：回報「我還在」(seenAt)、切換待機畫面「輪播 / 叫號」(view)
      allow update: if (onlyChanged(['seenAt']) && request.resource.data.seenAt == request.time)
        || (onlyChanged(['view']) && request.resource.data.view in ['carousel', 'board'])
        || (isStaff() && screenOk());
      allow delete: if isStaff();
    }

    // ===== 公開叫號資料：只有製作中、可取餐的編號(不含姓名電話)，叫號頁不用登入就能讀 =====
    match /board/{docId} {
      allow get: if docId == 'today';
      allow list: if false;
      allow create, update: if docId == 'today' && isStaff()
        && request.resource.data.keys().hasOnly(['making', 'ready', 'updatedAt'])
        && request.resource.data.making is list && request.resource.data.making.size() <= 200
        && request.resource.data.ready is list && request.resource.data.ready.size() <= 200;
      allow delete: if isAdmin();
    }

    // ===== 缺貨替代設定記憶：攤位人員共用 =====
    match /subMemory/{key} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['candidates', 'updatedAt'])
        && request.resource.data.candidates is list && request.resource.data.candidates.size() <= 12;
      allow delete: if isAdmin();
    }

    // ===== 找回訂單：文件 ID 為「編號_電話」 =====
    match /lookups/{key} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (getAfter(path('orders', request.resource.data.orderId)).data.get('uid', null) == uid() || isStaff());
      allow delete: if isAdmin();
    }

    // ===== 推播 token：只寫不讀，由 Apps Script 以服務帳戶讀取 =====
    match /pushTokens/{orderId} {
      allow read: if false;
      allow create, update: if signedIn()
        && exists(path('orders', orderId))
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // ===== 收件匣：超量預點通知 =====
    function inboxOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'surname', 'phone', 'summary', 'count', 'attempts', 'read', 'readAt', 'lastAt'])
        && d.type == 'over-limit' && d.count is int && d.attempts is int && d.read == false
        && d.lastAt == request.time
        && d.summary is string && d.summary.size() <= 300
        && d.surname is string && d.surname.size() <= 12
        && d.phone is string && d.phone.size() <= 12;
    }
    match /inbox/{userId} {
      allow read: if isStaff();
      allow create: if signedIn() && uid() == userId && inboxOk();
      allow update: if (signedIn() && uid() == userId && inboxOk())
        || (isStaff() && onlyChanged(['read', 'readAt']));
      allow delete: if isAdmin();
    }
  }
}
